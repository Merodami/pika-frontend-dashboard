{
  "name": "@pika/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Damian Meroni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merodami/pika-frontend-dashboard.git"
  },
  "homepage": "https://github.com/Merodami/pika-frontend-dashboard#readme",
  "bugs": {
    "url": "https://github.com/Merodami/pika-frontend-dashboard/issues"
  },
  "scripts": {
    "install:deps": "npx dotenv-cli -e .env -- npm install",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix && prettier --write .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format",
    "check": "npm run typecheck && npm run format && npm run lint",
    "check:fix": "npm run format:fix && npm run lint:fix && npm run typecheck",
    "pre-commit": "npm run format:fix && npm run lint:fix && npm run typecheck && npm run build",
    "quality": "npm run quality:type-coverage && npm run quality:circular && npm run quality:duplicates",
    "quality:type-coverage": "type-coverage --detail --strict --project tsconfig.json --ignore-files 'lib/api/generated/**' --ignore-files '.next/**' --ignore-files 'reports/**'",
    "quality:circular": "madge --circular --extensions ts,tsx ./",
    "quality:duplicates": "jscpd . --reporters html,console --output reports/duplicates",
    "quality:bundle": "next-bundle-analyzer",
    "quality:unused": "knip",
    "quality:all": "npm run quality && npm run quality:bundle && npm run quality:unused",
    "analyze": "ANALYZE=true npm run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "generate:api": "orval --config orval.config.ts",
    "update:deps": "npx dotenv-cli -e .env -- npm install @merodami/pika-api@latest @merodami/pika-types@latest",
    "prepare": "husky install || true",
    "vercel:build": "vercel build",
    "vercel:dev": "vercel dev",
    "vercel:prod": "NODE_ENV=production npm ci --omit=dev && npm run build",
    "vercel:test": "npm run vercel:prod"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.0.0",
    "@ant-design/nextjs-registry": "^1.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.1",
    "@merodami/pika-api": "^1.1.24",
    "@merodami/pika-types": "^1.1.24",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.84.2",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@uppy/compressor": "^3.0.0",
    "@uppy/core": "^5.0.0",
    "@uppy/dashboard": "^5.0.0",
    "@uppy/image-editor": "^4.0.0",
    "@uppy/react": "^5.0.0",
    "@uppy/xhr-upload": "^5.0.0",
    "antd": "^5.26.7",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "form-data": "^4.0.4",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.539.0",
    "next": "^15.4.6",
    "next-intl": "^4.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.0.16",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.6",
    "@playwright/test": "^1.54.2",
    "@types/form-data": "^2.5.2",
    "@types/morgan": "^1.9.10",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axios-debug-log": "^1.0.0",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^5.62.0",
    "lint-staged": "^16.1.5",
    "madge": "^8.0.0",
    "morgan": "^1.10.1",
    "orval": "^7.11.2",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538"
}
