{
  "threshold": 0,
  "reporters": ["html", "json", "console"],
  "ignore": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/public/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/generated/**",
    "**/lib/api/generated/**",
    "**/reports/**"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx", "css"],
  "minTokens": 50,
  "minLines": 5,
  "maxLines": 500
}
